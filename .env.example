# OpenSearch admin password (required by OpenSearch 2.12+).
# Must be at least 16 chars with uppercase, lowercase, digit, and special char.
# NOTE: Avoid '#' in the password — Docker Compose .env parsing may truncate at '#'.
OPENSEARCH_ADMIN_PASSWORD=ChangeMeToSomethingStrong!23

# OpenSearch data directory on the host. Set to a host path to use a bind
# mount instead of a Docker named volume. Useful for NFS/network storage.
# Leave commented to use the default Docker named volume (opensearch-data).
# OPENSEARCH_DATA_DIR=/mnt/nsf-volume/opensearch

# OpenSearch MCP server connection. The opensearch-mcp service reaches
# OpenSearch over the internal logging-net network by default.
# OPENSEARCH_URL=https://opensearch:9200
# OPENSEARCH_USERNAME=admin
# (OPENSEARCH_PASSWORD is sourced from OPENSEARCH_ADMIN_PASSWORD above)

# corex_manager Docker Compose project name (used to derive the external
# corex-net network name that the opensearch-mcp service joins so coreX
# Manager can reach it as an MCP tool server).
# Change if you set COMPOSE_PROJECT_NAME in corex or deployed to a different
# directory.
COREX_NETWORK_NAME=haproxy_manager_corex-net

