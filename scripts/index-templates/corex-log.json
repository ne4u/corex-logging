{
  "index_patterns": ["corex-log-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "properties": {
        "unique_id": { "type": "keyword" },
        "@timestamp": { "type": "date" },
        "unique_id_client_ip": { "type": "ip" },
        "unique_id_client_port": { "type": "integer" },
        "unique_id_timestamp": { "type": "long" },
        "unique_id_timestamp_iso": { "type": "date" },
        "unique_id_request_counter": { "type": "integer" },
        "unique_id_pid": { "type": "integer" },
        "client": { "type": "ip" },
        "client_port": { "type": "integer" },
        "xff": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "frontend": { "type": "keyword" },
        "backend": { "type": "keyword" },
        "host": { "type": "keyword" },
        "method": { "type": "keyword" },
        "path": { "type": "keyword" },
        "query": { "type": "keyword" },
        "user_agent": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "referer": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } },
        "status": { "type": "integer" },
        "status_source": { "type": "keyword" },
        "bytes_out": { "type": "long" },
        "be_response_time": { "type": "integer" },
        "be_connect_time": { "type": "integer" },
        "total_time": { "type": "integer" },
        "termination": { "type": "keyword" },
        "action": { "type": "keyword" },
        "sec_rule": { "type": "keyword" },
        "risk_score": { "type": "integer" },
        "risk_rules_hit": { "type": "keyword" },
        "risk_rules_hit_count": { "type": "integer" },
        "risk_hit_density": { "type": "keyword" },
        "rl_name": { "type": "keyword" },
        "waf_status": { "type": "keyword" },
        "waf_anomaly_score": { "type": "integer" },
        "waf_rules_hit": { "type": "keyword" },
        "waf_rule_ids": { "type": "keyword" },
        "server": { "type": "keyword" },
        "country": { "type": "keyword" },
        "asn": { "type": "keyword" },
        "asn_org": { "type": "keyword", "ignore_above": 256 },
        "asn_network": { "type": "keyword" },
        "city": { "type": "keyword" },

        "ja4": { "type": "keyword" },
        "ja4_a": { "type": "keyword" },
        "ja4_b": { "type": "keyword" },
        "ja4_c": { "type": "keyword" },
        "ja4_proto": { "type": "keyword" },
        "ja4_protocol": { "type": "keyword" },
        "ja4_version": { "type": "keyword" },
        "ja4_tls_version": { "type": "keyword" },
        "ja4_sni": { "type": "keyword" },
        "ja4_sni_present": { "type": "keyword" },
        "ja4_cipher_count": { "type": "integer" },
        "ja4_ext_count": { "type": "integer" },
        "ja4_alpn": { "type": "keyword" },
        "ja4_alpn_decoded": { "type": "keyword" },
        "ja4_cipher_hash": { "type": "keyword" },
        "ja4_ext_hash": { "type": "keyword" },

        "req_fp": { "type": "keyword" },
        "req_fp_path_b62": { "type": "keyword" },
        "req_fp_method_raw": { "type": "keyword" },
        "req_fp_method": { "type": "keyword" },
        "req_fp_http_ver_raw": { "type": "keyword" },
        "req_fp_http_ver": { "type": "keyword" },
        "req_fp_path_depth": { "type": "integer" },
        "req_fp_param_keys": { "type": "keyword" },
        "req_fp_param_types_raw": { "type": "keyword" },
        "req_fp_param_types": { "type": "keyword" },
        "req_fp_param_lens": { "type": "keyword" },
        "req_fp_ctype": { "type": "keyword" },
        "req_fp_hdr_count": { "type": "integer" },
        "req_fp_hdr_list": { "type": "keyword" },
        "req_fp_accept_lang": { "type": "keyword" },
        "req_fp_auth_type_raw": { "type": "keyword" },
        "req_fp_auth_type": { "type": "keyword" },
        "req_fp_cookie_raw": { "type": "keyword" },
        "req_fp_cookie": { "type": "keyword" },
        "req_fp_cookie_fields": { "type": "keyword" },
        "req_fp_referer_raw": { "type": "keyword" },
        "req_fp_referer": { "type": "keyword" },
        "req_fp_status": { "type": "integer" },
        "req_fp_body_bytes": { "type": "long" },

        "_parse_error": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } }
      }
    }
  }
}
